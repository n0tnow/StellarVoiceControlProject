# Polaris — environment template.
# Copy to `.env` (gitignored) and fill in. NEVER commit real keys.

# ── Agent / LLM (step A2) ────────────────────────────────────────────────────
# OpenAI-compatible chat-completions provider. The client in agent/src/llm is
# vendor-neutral, so switching to Groq or OpenRouter is ONLY a change of these
# three values (Anthropic is not used).
#
# Provider default: OpenCode Zen Go. Two quirks are known and handled by the
# client: the endpoint rejects a request without a per-conversation
# `x-opencode-session` header, and it wants a descriptive `User-Agent`.
POLARIS_AGENT_BASE_URL=https://opencode.ai/zen/go/v1
POLARIS_AGENT_MODEL=deepseek-v4.1-flash
# Bearer credential for the provider above. Read from the environment (or this
# gitignored file) only; never committed, never logged. The desktop webview does
# NOT receive it: the Vite dev server proxies `/agent-api` and injects it
# server-side (see app/vite.config.ts), so a built bundle contains no secret.
OPENCODE_API_KEY=

# ── Stellar (Owner B) ────────────────────────────────────────────────────────
# testnet only — mainnet is an explicit non-goal (docs/architecture.md §1).
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ─ Anchor (TRY on/off-ramp, standard SEP-1/10/12/38/6 only) ─────────────────
# The home domain is the ONLY anchor input (default: tr-mock-anchor.fly.dev).
# Shared treasury: keep test deposits small (50-100 TRY). Be gentle.
POLARIS_ANCHOR_HOME_DOMAIN=
# TEST ONLY: throwaway testnet secret for `npm run anchor:e2e -w @polaris/stellar`
# and unit tests. Never a real key. Leave empty to let the e2e generate one in memory.
POLARIS_TEST_SECRET=

# ── Speech-to-text backend selection (step A1) ───────────────────────────────
# `ondevice` (DEFAULT) transcribes with Apple's on-device SFSpeechRecognizer:
# the audio never leaves this Mac, it is free forever and needs no key. `groq`
# opts into the cloud. An unknown value falls back to `ondevice` and warns.
# When `ondevice` is unavailable for the locale AND `GROQ_API_KEY` is set, Groq
# is used as a fallback (logged; the audio then leaves the machine). If no key
# is set, the failure is surfaced ("Local STT off") instead of silently
# uploading audio.
POLARIS_STT_BACKEND=ondevice
# Locale for the on-device recognizer. Empty means the fixed default `tr-TR`
# (the user speaks Turkish); `en-US` is the main alternative. SFSpeechRecognizer
# is single-locale, so this is not auto-detected the way Groq chooses a language.
POLARIS_STT_LOCALE=

# ── Cloud speech-to-text (step A1, explicit opt-in / fallback) ───────────────
# Groq OpenAI-compatible transcription key (create one at
# https://console.groq.com/keys). NEVER commit a real key; `.env` is gitignored
# and the app only ever reads it from the environment or this file.
# If it is unset, capture still works: transcription reports a short label and
# the terminal explains what to set.
GROQ_API_KEY=
# Model id. `whisper-large-v3-turbo` is the fast/cheap multilingual default.
POLARIS_STT_MODEL=whisper-large-v3-turbo
# ISO-639-1 hint (e.g. `tr`) for the audio language. Leave EMPTY to let the model
# auto-detect, which is the default because commands mix Turkish and English
# (e.g. "ADA'ya 10 USDC gönder"); forcing `tr` mangles the English tokens.
POLARIS_STT_LANGUAGE=

# ── Local speech (steps A1 / A3) ─────────────────────────────────────────────
# Local whisper.cpp model path (Metal), used once the local backend is added.
# Model files are gitignored (`models/`).
POLARIS_WHISPER_MODEL=models/ggml-base.en.bin
# macOS system voice used by TTS until/unless a premium voice is wired.
POLARIS_TTS_VOICE=

# ── Keeper (stellar/src/keeper) — triggers due polaris_guard schedules ───────
# Untrusted by design: this key only pays fees. Fund it with a little testnet
# XLM and nothing else. Never reuse a user key here.
KEEPER_SECRET=
GUARD_CONTRACT_ID=
# Optional (defaults in parentheses). SOROBAN_RPC_URL / NETWORK_PASSPHRASE fall
# back to the STELLAR_* values above, then to the public testnet.
SOROBAN_RPC_URL=
NETWORK_PASSPHRASE=
KEEPER_POLL_SECONDS=
KEEPER_MAX_PER_TICK=
KEEPER_DRY_RUN=
KEEPER_TX_TIMEOUT_SECONDS=
KEEPER_MAX_FEE_STROOPS=
KEEPER_LOG_LEVEL=
