# Polaris — environment template.
# Copy to `.env` (gitignored) and fill in. NEVER commit real keys.

# ── Agent (step A2) ──────────────────────────────────────────────────────────
# Anthropic API key used by the agent core (agent/). Read from the environment
# only; it is never written to disk by the app.
ANTHROPIC_API_KEY=
# Model id for the agent core. Keep it in one place so all agents agree.
POLARIS_AGENT_MODEL=claude-sonnet-4-5

# ── Stellar (Owner B) ────────────────────────────────────────────────────────
# testnet only — mainnet is an explicit non-goal (docs/architecture.md §1).
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ─ Anchor (TRY on/off-ramp, standard SEP-1/10/12/38/6 only) ─────────────────
# The home domain is the ONLY anchor input (default: tr-mock-anchor.fly.dev).
# Shared treasury: keep test deposits small (50-100 TRY). Be gentle.
POLARIS_ANCHOR_HOME_DOMAIN=
# TEST ONLY: throwaway testnet secret for `npm run anchor:e2e -w @polaris/stellar`
# and unit tests. Never a real key. Leave empty to let the e2e generate one in memory.
POLARIS_TEST_SECRET=

# ── Local speech (steps A1 / A3) ─────────────────────────────────────────────
# Local whisper.cpp model path (Metal). Model files are gitignored (`models/`).
POLARIS_WHISPER_MODEL=models/ggml-base.en.bin
# macOS system voice used by TTS until/unless a premium voice is wired.
POLARIS_TTS_VOICE=

# ── Keeper (stellar/src/keeper) — triggers due polaris_guard schedules ───────
# Untrusted by design: this key only pays fees. Fund it with a little testnet
# XLM and nothing else. Never reuse a user key here.
KEEPER_SECRET=
GUARD_CONTRACT_ID=
# Optional (defaults in parentheses). SOROBAN_RPC_URL / NETWORK_PASSPHRASE fall
# back to the STELLAR_* values above, then to the public testnet.
SOROBAN_RPC_URL=
NETWORK_PASSPHRASE=
KEEPER_POLL_SECONDS=
KEEPER_MAX_PER_TICK=
KEEPER_DRY_RUN=
KEEPER_TX_TIMEOUT_SECONDS=
KEEPER_MAX_FEE_STROOPS=
KEEPER_LOG_LEVEL=
