# Polaris — environment template.
# Copy to `.env` (gitignored) and fill in. NEVER commit real keys.
# Discovery: the shell loads the nearest `.env` walking up from its working
# directory; a Finder-launched app falls back to ~/Library/Application Support/Polaris/.env.

# ── Agent / LLM (step A2; provider split in A11) ─────────────────────────────
# The provider is selected by POLARIS_AGENT_PROVIDER and the model by
# POLARIS_AGENT_MODEL, so switching provider/model is a .env change only.
#
#   openai (default) — any OpenAI-compatible root (OpenCode Zen Go, Groq, …).
#   anthropic        — the Anthropic Messages API (claude-sonnet-5,
#                      claude-haiku-4-5). It is NOT OpenAI-compatible, so it has
#                      its own base URL and key below.
#
# Model choice (step A5): `glm-5.3-flash` for the OpenAI-compatible default.
# Benchmark 2026-09-19 (real Turkish payment command + tool calling, 3 runs):
# median 1857 ms vs deepseek-v4.1-flash 2085 ms, 0 wrong answers for either, and
# glm spends 0 reasoning tokens so its latency is more predictable.
POLARIS_AGENT_PROVIDER=openai
POLARIS_AGENT_BASE_URL=https://opencode.ai/zen/go/v1
POLARIS_AGENT_MODEL=glm-5.3-flash
# Bearer credential for the OpenAI-compatible provider. Read from the
# environment (or this gitignored file) only; never committed, never logged. The
# desktop webview does NOT receive it: the provider request is made by the Rust
# `agent_chat` command (see app/src-tauri/src/agent.rs), so a built bundle
# contains no secret.
OPENCODE_API_KEY=
#
# ── Anthropic (step A11, used when POLARIS_AGENT_PROVIDER=anthropic) ──────────
# Set these to compare `claude-sonnet-5` / `claude-haiku-4-5` against glm:
#   POLARIS_AGENT_PROVIDER=anthropic
#   POLARIS_AGENT_MODEL=claude-sonnet-5   # or claude-haiku-4-5 (never a date suffix)
# An API key from https://console.anthropic.com. Sent as `x-api-key` (NOT a
# Bearer token) by the Rust transport; it never reaches the webview bundle.
ANTHROPIC_API_KEY=
# Optional Anthropic-compatible proxy root. Default https://api.anthropic.com.
POLARIS_ANTHROPIC_BASE_URL=

# ── Approval seam (step A9 / M5) ─────────────────────────────────────────────
# Non-secret kill-switch for the intent approval gate. The default is FAIL
# CLOSED: a deny-all approver, so no chain tool can run without a real gesture.
# `1` installs the loud auto-approving placeholder, which is safe ONLY while the
# chain tools are stubs. Unset it (or set anything else) before any real
# value-moving tool ships, and never rely on it outside a stubbed demo.
POLARIS_ALLOW_AUTO_APPROVE=

# ── Per-turn timing (step A11) ───────────────────────────────────────────────
# ON by default: after every spoken turn the Rust terminal prints one block with
# each phase's duration (hotkey release → WAV ready → transcript → provider
# request/first byte/full response → intent parsed → sentence built → TTS
# request → first audio byte → playback start → playback end). Set to `0` to
# silence it. Read by the Rust shell only.
POLARIS_TIMING=

# ── Stellar (Owner B) ────────────────────────────────────────────────────────
# testnet only — mainnet is an explicit non-goal (docs/architecture.md §1).
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
#
# ── Owner wallet + recipient aliases (step W1) ───────────────────────────────
# The PUBLIC address that pays (the app never holds a secret key and never signs
# here). Read in Rust by the `stellar_config` command; deliberately NOT exposed to
# the webview by the Vite `envPrefix`. Missing -> the shell refuses with
# "Set POLARIS_OWNER_ADDRESS" instead of guessing.
# POLARIS_OWNER_ADDRESS=G...  # your PUBLIC testnet G... address (required to send)
# Extra recipient aliases, comma-separated `alias=G...` pairs, merged OVER the
# committed `stellar/config/aliases.json` (the environment wins). Alias names are
# lowercase `[a-z][a-z0-9_-]{0,31}`; addresses must be a valid testnet G... strkey.
# POLARIS_ALIASES=acc2=G...  # placeholder shape only — never commit real addresses
# W10 embedded wallet: the macOS Keychain is the only seed store by default.
# Set to 1 ONLY on a throwaway testnet machine to allow the 0600 plaintext file
# fallback when the Keychain is unavailable; it is never a default.
# POLARIS_WALLET_ALLOW_FILE_STORE=1

# ─ Anchor (TRY on/off-ramp, standard SEP-1/10/12/38/6 only) ─────────────────
# The home domain is the ONLY anchor input (default: tr-mock-anchor.fly.dev).
# Shared treasury: keep test deposits small (50-100 TRY). Be gentle.
POLARIS_ANCHOR_HOME_DOMAIN=
# TEST ONLY: throwaway testnet secret for `npm run anchor:e2e -w @polaris/stellar`
# and unit tests. Never a real key. Leave empty to let the e2e generate one in memory.
POLARIS_TEST_SECRET=

# ── Speech-to-text backend selection (steps A1 / A12) ────────────────────────
# `groq` (DEFAULT since A12) transcribes with the multilingual
# `whisper-large-v3-turbo` and **detects the spoken language itself**, so an
# English command cannot be phoneticised as Turkish. The audio leaves this Mac
# for transcription, which the startup line states. `ondevice` opts into Apple's
# on-device SFSpeechRecognizer: private (audio never leaves the Mac), free and
# fast, but **single-locale** — it cannot identify the language, so only one of
# Turkish/English is recognized correctly. An unknown value falls back to `groq`
# and warns.
# For the on-device backend, Groq is attached as a fallback only when
# `GROQ_API_KEY` is set and on-device is unavailable *before* it recognized
# anything; the audio then leaves the machine, which is logged loudly.
POLARIS_STT_BACKEND=groq
# Locale for the on-device recognizer. Empty means the fixed default `tr-TR`.
# Only used when `POLARIS_STT_BACKEND=ondevice`; SFSpeechRecognizer is
# single-locale, so this is not auto-detected the way Groq chooses a language.
POLARIS_STT_LOCALE=

# ── Cloud speech-to-text (step A1, explicit opt-in / fallback) ───────────────
# Groq OpenAI-compatible transcription key (create one at
# https://console.groq.com/keys). NEVER commit a real key; `.env` is gitignored
# and the app only ever reads it from the environment or this file.
# If it is unset, capture still works: transcription reports a short label and
# the terminal explains what to set.
GROQ_API_KEY=
# Model id. `whisper-large-v3-turbo` is the fast/cheap multilingual default.
POLARIS_STT_MODEL=whisper-large-v3-turbo
# ISO-639-1 hint (e.g. `tr`) for the audio language. Leave EMPTY to let the model
# auto-detect, which is the default because commands mix Turkish and English
# (e.g. "ADA'ya 10 USDC gönder"); forcing `tr` mangles the English tokens. When a
# language IS forced (`en`/`tr`) the vocabulary prompt below is built in that
# language only (F3-fix), and a transcript the model still labels in another
# language is rejected as "No speech".
POLARIS_STT_LANGUAGE=
# F3 vocabulary hint sent as the transcription `prompt`, so short command clips
# stop decoding to hallucinations or the wrong language. Leave EMPTY to build the
# language-appropriate default (English-only for `en`, Turkish-only for `tr`, a
# short bilingual sentence when auto-detecting) plus the alias names from
# POLARIS_ALIASES; set `off` to disable it entirely; set any text to replace it
# verbatim. It is one natural example sentence, never a bare word list — Whisper
# echoes a list back on short clips.
POLARIS_STT_PROMPT=
# F3: the languages an auto-detection may keep without a retry. If the detected
# language's base tag is not in this comma-separated list, the same audio is
# re-sent ONCE with the first listed language (default `tr,en`). Ignored when
# POLARIS_STT_LANGUAGE is set (that language is already forced).
POLARIS_STT_ALLOWED_LANGS=tr,en

# ── Local STT (step A1) ──────────────────────────────────────────────────────
# Local whisper.cpp model path (Metal), used once the local backend is added.
# Model files are gitignored (`models/`).
POLARIS_WHISPER_MODEL=models/ggml-base.en.bin

# ── Text-to-speech (steps A3 / A4) ───────────────────────────────────────────
# The assistant speaks its confirmation sentence or clarification aloud (A4).
# `fish` (default) uses Fish Audio as primary with a MANDATORY local macOS `say`
# fallback; `local` opts into on-device speech only. An unknown value warns and
# uses `fish`. The local fallback exists because the free tier has no SLA.
POLARIS_TTS_BACKEND=fish
# Fish Audio bearer token (create one at https://fish.audio). NEVER commit a real
# key; `.env` is gitignored and the key is only ever sent in the Authorization
# header — it is never logged, written or included in an error.
FISH_AUDIO_API_KEY=
# Fish Audio engine id, sent in the `model` header (the engine, not the voice).
POLARIS_TTS_MODEL=s2.1-pro-free
# The ONE voice every utterance uses, as a Fish Audio `reference_id`. REQUIRED
# for the `fish` backend: without it the voice would drift between requests, so
# no request is made and local speech is used instead. The owner swaps this one
# value to change the voice; nothing in code hardcodes a voice id.
# Shown: "Sarah" (female, Fish Official) — the pinned default in this worktree.
POLARIS_TTS_REFERENCE_ID=933563129e564b19a115bedd57b7406a
# Optional per-language VOICE override (step A11/A12, precedence inverted A14).
# The suffix is a BCP-47 language base; the value is a Fish `reference_id`. The
# reply/voice language is the model's assessment of the transcript text (A14);
# the STT-detected label is a hint the model may override. The matching voice is
# chosen in that language, falling back to POLARIS_TTS_REFERENCE_ID for every
# language without an override — the pinned voice is never changed silently. Set
# `_EN` (and `_TR`) so each language is spoken by a voice that suits it; without
# an override both languages use the pinned voice.
# Example (values are the owner's to set):
# POLARIS_TTS_REFERENCE_ID_TR=
# POLARIS_TTS_REFERENCE_ID_EN=
# Output container (`mp3` | `wav` | `pcm` | `opus`) and Fish latency/quality
# trade-off (`normal` | `balanced`). The defaults suit short spoken sentences.
POLARIS_TTS_FORMAT=mp3
POLARIS_TTS_LATENCY=normal
# Local macOS `say` voice, used as the fallback or when `POLARIS_TTS_BACKEND=local`.
POLARIS_TTS_LOCAL_VOICE=Yelda
# Optional per-language local voice override, same mechanism as Fish above.
# Example: POLARIS_TTS_LOCAL_VOICE_EN=Samantha
# POLARIS_TTS_LOCAL_VOICE_TR=
# POLARIS_TTS_LOCAL_VOICE_EN=

# ── Keeper (stellar/src/keeper) — triggers due polaris_guard schedules ───────
# Untrusted by design: this key only pays fees. Fund it with a little testnet
# XLM and nothing else. Never reuse a user key here.
KEEPER_SECRET=
GUARD_CONTRACT_ID=
# POLARIS_P2P_CONTRACT_ID=C...  # deployed polaris_p2p_escrow id (W8); unset disables P2P offers
# Optional (defaults in parentheses). SOROBAN_RPC_URL / NETWORK_PASSPHRASE fall
# back to the STELLAR_* values above, then to the public testnet.
SOROBAN_RPC_URL=
NETWORK_PASSPHRASE=
KEEPER_POLL_SECONDS=
KEEPER_MAX_PER_TICK=
KEEPER_DRY_RUN=
KEEPER_TX_TIMEOUT_SECONDS=
KEEPER_MAX_FEE_STROOPS=
KEEPER_LOG_LEVEL=
