{
  "name": "polaris",
  "version": "0.1.0",
  "private": true,
  "description": "Polaris — push-to-talk Stellar assistant (Genesis hackathon)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "interfaces",
    "agent",
    "stellar",
    "app"
  ],
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "typecheck": "npm run check --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run tauri:dev -w @polaris/app",
    "start:app": "npm run tauri:dev -w @polaris/app",
    "agent": "npm run start -w @polaris/agent",
    "stt:probe": "node --env-file-if-exists=/Users/bilalkaya/StellarVoiceControlProject/.env scripts/stt-probe.mjs",
    "e2e:intent": "node --env-file-if-exists=.env scripts/e2e-intent.mjs",
    "e2e:prompt": "node --env-file-if-exists=.env scripts/e2e-prompt-eval.mjs",
    "e2e:build-xdr": "node --env-file-if-exists=.env scripts/e2e-build-xdr.mjs",
    "p2p:live": "node --env-file-if-exists=.env scripts/p2p-live-read.mjs",
    "e2e:autopay": "node scripts/e2e-autopay.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}