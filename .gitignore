# ─────────────────────────────────────────────────────────────
# Secrets — NEVER commit these
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.seed
secrets/

# Stellar CLI project-local config. Identities here hold SECRET KEYS.
# (Global identities live in ~/.config/stellar, outside the repo.)
.stellar/

# ─────────────────────────────────────────────────────────────
# OS / editors
# ─────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp

# ─────────────────────────────────────────────────────────────
# Rust (Soroban contracts + Tauri core)
# Cargo.lock is intentionally NOT ignored (reproducible builds).
# ─────────────────────────────────────────────────────────────
target/
**/*.rs.bk

# ─────────────────────────────────────────────────────────────
# Node / TypeScript / Vite
# ─────────────────────────────────────────────────────────────
node_modules/
dist/
.vite/
.pnpm-store/
*.log
npm-debug.log*

# ─────────────────────────────────────────────────────────────
# Tauri generated files
# NOTE: the pattern must not be root-anchored — the Tauri app lives in
# `app/src-tauri`, so a bare `src-tauri/gen/schemas/` would never match and the
# generated schemas would silently get committed.
# ─────────────────────────────────────────────────────────────
**/src-tauri/gen/schemas/

# ─────────────────────────────────────────────────────────────
# Speech / AI local assets (large or private)
# ─────────────────────────────────────────────────────────────
models/
ggml-*.bin
*.gguf
recordings/
captures/
*.wav

# ─────────────────────────────────────────────────────────────
# Project workflow (see CLAUDE.md, worktree rule)
# ─────────────────────────────────────────────────────────────
.worktrees/
.claude/settings.local.json
tmp/
.tmp/

# Local user notes (machine setup, personal info; never committed)
LOCAL.md

# Model ladder is LOCAL-ONLY: environment-specific model assignments are
# user/machine specific and must never be committed. The file is kept on
# disk only (removed from the index via `git rm --cached`); its PONG test
# evidence lives in the local file itself, not in the repo.
docs/model-ladder.md

