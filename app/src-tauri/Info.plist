<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Tauri merges this file into the generated bundle Info.plist. Without the
	     microphone usage description, macOS terminates the process the first
	     time cpal opens the input device. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Autonomy records your voice while you hold the push-to-talk shortcut so it can transcribe your request.</string>
	<!-- Step A1 (on-device default): without this key macOS terminates the
	     process the first time `SFSpeechRecognizer.requestAuthorization` is
	     called. The sentence is shown verbatim in the system prompt. -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Autonomy transcribes your spoken wallet commands with on-device speech recognition, so your voice stays on this Mac by default.</string>
</dict>
</plist>
