<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime is required for notarization, and it revokes resource
	     access unless the matching entitlement is present. Autonomy opens the
	     default input device through `cpal` while push-to-talk is held, so
	     without this key the capture thread gets silence (or a killed process)
	     on a signed build even though Info.plist carries the usage string. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
